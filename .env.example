# Cloudflare Dashboard -> R2 -> your bucket
R2_ACCOUNT_ID=replace_with_cloudflare_account_id
R2_ACCESS_KEY_ID=replace_with_r2_access_key_id
R2_SECRET_ACCESS_KEY=replace_with_r2_secret_access_key
R2_BUCKET_NAME=replace_with_private_bucket_name

# Generate a long random secret (at least 32 characters). Never commit the real value.
STREAM_API_TOKEN=replace_with_a_random_secret_at_least_32_characters

# Maximum upload size in bytes (default 20 GiB)
MAX_VIDEO_BYTES=21474836480
